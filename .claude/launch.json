{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bancos-mcp",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "watch",
        "--project",
        "src/Bancos.Mcp/Bancos.Mcp.csproj",
        "--urls",
        "http://localhost:8000"
